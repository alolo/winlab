+
+        let worker = thread::spawn(move || run_queued_log_writer(receiver));
+        sender
+            .send(LogMessage::Write {
+                path: path.clone(),
+                bytes: b"first event\n".to_vec(),
+            })
+            .unwrap();
+        sender
+            .send(LogMessage::Write {
+                path: path.clone(),
+                bytes: b"second event\n".to_vec(),
+            })
+            .unwrap();
+
